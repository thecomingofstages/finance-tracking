  "item": [
    {
      "name": "1. Auth",
      "description": "9 endpoints minus the 3 Supabase-dependent ones. Run order: Login → Get Me → Verify Password → Refresh → Logout → Forgot → Reset (Reset needs a manually-pasted reset_token, see collection-level notes).",
      "item": [
        {
          "name": "0. Setup notes (read me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "Not an auth endpoint — a harmless request to hang these notes on. Needs a reachable Postgres with the seed data applied (see collection-level description). Claim / Login via Supabase / the Supabase session helper are intentionally NOT in this consolidated collection — see `TCOS-Auth.postman_collection.json` for those."
          },
          "response": []
        },
        {
          "name": "1. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  pm.collectionVariables.set('access_token', data.access_token);",
                  "  pm.test('got an access token', () => pm.expect(data.access_token).to.be.a('string'));",
                  "  pm.test('never leaks refresh_token or password_hash in the body', () => {",
                  "    pm.expect(data.refresh_token).to.be.undefined;",
                  "    pm.expect(data.staff.password_hash).to.be.undefined;",
                  "  });",
                  "  pm.test('sets an HttpOnly refresh_token cookie', () => {",
                  "    pm.expect(pm.cookies.has('refresh_token')).to.be.true;",
                  "  });",
                  "} else {",
                  "  pm.test('login failed — see response body', () => pm.expect.fail(pm.response.text()));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{auth_email}}\",\n  \"password\": \"{{auth_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "description": "#1 — real Staff lookup by email (case-insensitive), bcrypt.compare against password_hash."
          },
          "response": []
        },
        {
          "name": "2. Get Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is the real staff record, no password_hash', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.email).to.be.a('string');",
                  "  pm.expect(data.password_hash).to.be.undefined;",
                  "  pm.expect(data.scope).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] },
            "description": "#4 — real Staff row by the token's sub, real StaffDept-backed scope (resolveScope)."
          },
          "response": []
        },
        {
          "name": "3. Verify Password (step-up)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('reauth_token', pm.response.json().data.reauth_token);",
                  "  pm.test('got a reauth token', () => pm.expect(pm.response.json().data.reauth_token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"{{auth_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/verify-password", "host": ["{{base_url}}"], "path": ["auth", "verify-password"] },
            "description": "#59 — step-up re-auth. Real bcrypt.compare. Returns a 5-min reauth_token."
          },
          "response": []
        },
        {
          "name": "4. Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('access_token', pm.response.json().data.access_token);",
                  "  pm.test('got a new access token', () => pm.expect(pm.response.json().data.access_token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] },
            "description": "#3 — relies entirely on the refresh_token cookie Postman captured from Login."
          },
          "response": []
        },
        {
          "name": "5. Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] },
            "description": "#2 — clears the refresh_token cookie."
          },
          "response": []
        },
        {
          "name": "6. Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{auth_email}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/password/forgot", "host": ["{{base_url}}"], "path": ["auth", "password", "forgot"] },
            "description": "#5 — always returns the same generic message. No email provider wired up, so on a real match the server LOGS the reset link — copy `reset_token` out of the server console into the collection variable if you want the next request to pass."
          },
          "response": []
        },
        {
          "name": "7. Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reset_token\": \"{{reset_token}}\",\n  \"password\": \"a-brand-new-password\"\n}" },
            "url": { "raw": "{{base_url}}/auth/password/reset", "host": ["{{base_url}}"], "path": ["auth", "password", "reset"] },
            "description": "#6 — will 400 on a cold Runner pass unless `reset_token` was pasted in from the server log first (real, unavoidable gap — see collection-level notes). Non-fatal to the rest of the run."
          },
          "response": []
        }
      ]
    },
    {
