              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{base_url}}/admin/staff/import", "host": ["{{base_url}}"], "path": ["admin", "staff", "import"] },
            "description": "#11 — needs a real CSV attached to the `file` field manually (Postman can't embed one in collection JSON); will 400 on an unattended run otherwise — expected, not a bug. Use `api/tests/fixtures/staff-import.csv`. Re-running the same file twice 400s on the second run (duplicate emails) — also expected."
          },
