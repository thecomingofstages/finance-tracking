        {
          "name": "5. Delete Staff",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/admin/staff/{{created_staff_id}}", "host": ["{{base_url}}"], "path": ["admin", "staff", "{{created_staff_id}}"] },
            "description": "#13 — soft-delete (deleted_at), not a hard delete."
          },
          "response": []
        }
      ]
    },
