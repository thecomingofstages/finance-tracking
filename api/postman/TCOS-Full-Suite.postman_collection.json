            ],
            "body": { "mode": "raw", "raw": "{\n  \"nickname\": \"MayUpdated\",\n  \"role\": \"finance\"\n}" },
            "url": { "raw": "{{base_url}}/admin/staff/{{created_staff_id}}", "host": ["{{base_url}}"], "path": ["admin", "staff", "{{created_staff_id}}"] },
            "description": "#12 — whitelist is nickname/phone/line_id/title/first_name/last_name/email/role."
