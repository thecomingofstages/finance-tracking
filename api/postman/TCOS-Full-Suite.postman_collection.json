            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"นางสาว\",\n  \"first_name\": \"May\",\n  \"last_name\": \"Sukjai\",\n  \"nickname\": \"May\",\n  \"email\": \"may.postman.{{$timestamp}}@tcos.app\",\n  \"phone\": \"0899999999\"\n}"
            },
            "url": { "raw": "{{base_url}}/admin/staff", "host": ["{{base_url}}"], "path": ["admin", "staff"] },
            "description": "#10 — email is timestamp-suffixed so this collection is safely re-runnable without a 409 DUPLICATE_EMAIL. Sets created_staff_id."
          },
          "response": []
