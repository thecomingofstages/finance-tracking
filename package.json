{
  "name": "finance-tracking",
  "version": "1.0.0",
  "description": "TCOS's Financial Tracking System",
  "main": "index.js",
  "scripts": {
    "test": "npm test",
    "_comment:supabase": "node --env-file-if-exists feeds api/.env to the CLI for the env() substitutions in supabase/config.toml — the CLI has no --env-file flag and only reads a .env in its own cwd. Not shell sourcing: api/.env has an unquoted multi-word PEM. See AGENTS.md > supabase/.",
    "supabase:start": "node --env-file-if-exists=api/.env node_modules/.bin/supabase start",
    "supabase:stop": "node --env-file-if-exists=api/.env node_modules/.bin/supabase stop",
    "supabase:status": "node --env-file-if-exists=api/.env node_modules/.bin/supabase status",
    "supabase:reset": "node --env-file-if-exists=api/.env node_modules/.bin/supabase db reset",
    "install:all": "npm install && npm install --prefix api && npm install --prefix web",
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev --prefix api\" \"npm run dev --prefix web\"",
    "dev:api": "npm run dev --prefix api",
    "dev:web": "npm run dev --prefix web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecomingofstages/finance-tracking.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thecomingofstages/finance-tracking/issues"
  },
  "homepage": "https://github.com/thecomingofstages/finance-tracking#readme",
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.1",
    "concurrently": "^8.2.2",
    "supabase": "^2.109.1"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
